# @name    BeautifulWeather
# @desc    Animated 16x16 weather symbols, big temperature and humidity, hourly curve; turn the knob for rain in the next 3 hours, wind with a wind rose, a 3-day forecast, sunrise/sunset and the moon with moonrise/moonset (52x16, Ulanzi TC002)
# @author  Hank_the_Tank / Claude
# @version 3.1
# @display 52x16
# @config  lang  select "Language"           default=English options=English,Deutsch help="Language of the texts on the panel (rain page, weekdays)" group="Location"
# @config  lat   number "Latitude"           default=52.52 min=-90 max=90 step=0.0001 group="Location"
# @config  lon   number "Longitude"          default=13.40 min=-180 max=180 step=0.0001 group="Location"
# @config  unit  select "Temperature unit"   default=C options=C,F group="Weather"
# @config  view  select "Graph"              default=auto options=auto,today,next24 help="auto: today (0-24 h) until 18:00, then the next 24 h" group="Weather"
# @config  hum   select "Humidity"           default=beside options=beside,alternate,off help="beside: next to the temperature. alternate: takes turns with the temperature every 4 s" group="Weather"
# @config  hcol  color  "Humidity colour"    default=#31B8DB group="Weather"
# @config  wind  number "Windy from"         default=30 min=10 max=100 unit=km/h help="Dry weather with at least this wind speed shows the windy symbol" group="Weather"
# @config  wunit select "Wind unit"          default=km/h options=km/h,m/s,mph,kn,Bft help="Unit of wind and gusts on the wind page" group="Weather"
# @config  cloud number "Cloudy from"        default=70 min=30 max=100 unit=% help="Dry weather: cloudy from this cloud cover, partly cloudy from half of it" group="Weather"
# @config  mcol  color  "Midnight tick"      default=#2040A0 help="Only in the next24 graph" group="Weather"
# @config  ncol  color  "Noon tick"          default=#A08000 group="Weather"
# @config  mode  select "Page change"        default=knob options=knob,auto help="knob: turn the knob to switch pages. auto: pages change by themselves, the knob keeps brightness/volume" group="Pages"
# @config  psec  number "Time per page"      default=6 min=2 max=60 unit=s help="Only in auto mode: how long each page is shown (3-day forecast at least 10.5 s, wind and moon at least 8 s)" group="Pages"
# @config  dur   number "Display time"       default=10 min=3 max=60 unit=s help="Knob mode: how long the app stays in the rotation (auto: sum of all pages)" group="Pages"
# @config  rain  bool   "Rain page"          default=true help="Knob page: rain in the next 3 hours, when it starts or stops" group="Pages"
# @config  windp bool   "Wind page"          default=true help="Knob page: wind rose with direction, wind and gusts, the next 12 hours as bars" group="Pages"
# @config  fcst  bool   "3-day forecast"     default=true help="Knob page: tomorrow and the two days after, 3.5 s each" group="Pages"
# @config  sunp  bool   "Sun page"           default=true help="Knob page: sunrise and sunset (after sunset the times of tomorrow)" group="Pages"
# @config  moon  bool   "Moon page"          default=true help="Knob page: moon phase with moonrise and moonset. Turn right = next page, left = back" group="Pages"
# @config  hold  number "After turning"      default=20 min=5 max=120 unit=s help="Knob mode: after the last turn the app stays this long, then the rotation moves on" group="Pages"
#
# Moon pictures by LeonCB (AWTRIX Hub, awtrix.de/icons/full-moon and new-moon), embedded; every phase is computed from them.
# Cloud style and shape after LeonCB's "rainy" icon (awtrix.de/icons/rainy-2).
# Automatic page change: idea and first version by DennsDJ.
import math
import string

class BeautifulWeather
  var url, unit, view, wind, cloud, mcol, ncol, dur, hold, moon, lat, lon   # settings
  var st, bm, fb, rn, L, wp, bolt, sk, rb, rs8     # colour stops, glyphs, icon buffer, random table, layers, shapes
  var mh, mimg, mi, mr, mst, rs, ss, nev, mtw   # moon: hex images, decoded image, phase; rise/set
  var wk, wh, traw, tc5, hr, tg, tu, tx, hum, hcol, hraw, hg, hx, hc5, nar, ly                 # weather symbol, temperature, gradient, hourly values
  var ay, ac, ad, ab, fx, today, bh, nx, tm, tn # graph
  var mday, mhr, mmin, ticks, age, busy, t0, tid, hst   # hst: status of a failed weather request
  var mf, mpg, mpw, mc5, mc5f                    # moon: phase 0..1, lit-% glyphs and width, colours (+ faded copy)
  var de, auto, psec, atid                      # German panel texts; automatic page change, ms per page, its timer
  var pages, pi, pp, ps, tp, ts                 # knob pages (0 weather, 1 rain, 2 moon), index, previous, start times
  var mp, mt0, rbh, rbc, rtk, rtt, rtc, rtx, rst, ut   # rain page: 15-min mm from mt0, bars, text, state, umbrella top
  var sr, su, srs, sss, snev, stw, fd, fdd       # sun rise/set (epoch), strings, next event; daily forecast
  var qi, sl, wsv, rq                           # rain/snow amount factor, wind slant, wind speed, mm now
  var wst, wunit, wdv, wgv, whr, wgr, wv, wb, wc5f, wnc   # wind page: colour stops, unit, direction, gusts, hourly, digits, bars

  def init()
    # Temperature colour stops: lower bound, colour - interpolated in between
    self.st = [-12, 0xD977DF, -6, 0x9545BC, -1, 0x4B379C, 0, 0xFEC4FF,
               4, 0x31B8DB, 10, 0x31DB8B, 15, 0x6ED228, 21, 0xFFFF28,
               27, 0xF87E27, 32, 0xCF3927, 38, 0xA12527]
    # Block glyphs 3x5, drawn at 2x (6x10): digits 0-9, 10 minus, 11 percent, 12 F, 13 C
    self.bm = [0x7B6F, 0x2C97, 0x73E7, 0x73CF, 0x5BC9, 0x79CF, 0x79EF, 0x7249, 0x7BEF, 0x7BCF,
               0x01C0, 0x52A5, 0x79A4, 0x7927]
    self.lat = store.get("lat")
    self.lon = store.get("lon")
    self.unit = store.get("unit")
    self.view = store.get("view")
    self.wind = store.get("wind")
    self.cloud = store.get("cloud")
    self.mcol = store.get("mcol")
    self.ncol = store.get("ncol")
    self.dur = store.get("dur")
    self.de = store.get("lang") == "Deutsch"
    self.auto = store.get("mode") == "auto"
    self.psec = int(store.get("psec")) * 1000
    self.atid = nil
    self.hold = store.get("hold")
    self.moon = store.get("moon")
    self.url = "http://api.open-meteo.com/v1/forecast" +
               "?latitude=" + str(self.lat) + "&longitude=" + str(self.lon) +
               "&current=temperature_2m,relative_humidity_2m,is_day,weather_code,wind_speed_10m,wind_direction_10m,wind_gusts_10m,cloud_cover,precipitation" +
               "&minutely_15=sunshine_duration,precipitation&forecast_minutely_15=16" +
               "&hourly=temperature_2m,wind_speed_10m,wind_gusts_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,precipitation_probability_max" +
               "&forecast_days=4&timeformat=unixtime&timezone=auto"

    # 16x16 frame buffer for the weather symbol, a fixed pseudo-random table for particles
    self.fb = []
    for i : 0 .. 255 self.fb.push(0) end
    self.rn = []
    var s = 20261011
    for i : 0 .. 63
      s = (s * 1103515245 + 12345) % 2147483648
      self.rn.push(((s >> 10) % 1000) / 1000.0)
    end

    # Clouds in pixel-art style (like the rainy-2 icon): 1 light top, 2 shadow row and notches, 3 dark base
    var cb = ["......111.......",
              ".....11111......",
              "..11.111111.11..",
              ".11112111111211.",
              "111111111111112.",
              "322222222222223.",
              ".3333333333333.."]
    var cs = ["....111.....",
              ".11.11111.11",
              "111211111211",
              "322222222223",
              ".3333333333."]
    var mo = ""
    var ms = "000000002BFF55FF000000000000000023FFCDF7FFEBFFE8FFEDAAFA00000000D5F6FFE0FFCFFFCAFFD2FFE4AAFA000032E82BCD5CB6EAADFFBAFFD2FFED00000000000000002B90F8ADFFCAFFE855FF0000000000000000A3B6FFCFFFEB2BFF000000000000000080CDFFE0CDF700000000000000000000B1E8D5F623FF0000000000000000000055FF000000000000"
    self.L = {
      "cl": self.pix(cb, [0xEBF0F5, 0xBEC8D2, 0x788291]),   # big cloud, light
      "cd": self.pix(cb, [0xBCC4D0, 0x8E98A6, 0x5A6372]),   # big cloud, rain
      "ct": self.pix(cb, [0x8A90A0, 0x666C7C, 0x41465A]),   # big cloud, thunder
      "cf": self.pix(cb, [0xFFFFFF, 0xE4EAF2, 0xA8B2C0]),   # big cloud, lit by lightning
      "kl": self.pix(cb, [0xA6AEBC, 0x808A98, 0x566070]),   # big cloud behind
      "sl": self.pix(cs, [0xEBF0F5, 0xBEC8D2, 0x788291]),   # small cloud, front
      "su": self.tint(3, 3, 10, 10, "", 0xFF9000, 0xFFF8C0),
      "ss": self.tint(7, 1, 8, 8, "0000000000005500550000000000000000004700F144FF70FF70F144470000000000F144FF9CFFC8FFC8FF9CF14400005500FF70FFC8FFF4FFF4FFC8FF7055005500FF70FFC8FFF4FFF4FFC8FF7055000000F144FF9CFFC8FFC8FF9CF144000000004700F144FF70FF70F1444700000000000000000055005500000000000000", 0xFF8400, 0xFFF6B0),
      "mo": self.tint(1, 2, 12, 12, mo, 0xA8925A, 0xFFF4C8),
      "ms": self.tint(8, 0, 8, 9, ms, 0xA8925A, 0xFFF4C8)
    }
    # Umbrella for the rain page: open, and furled when it stays dry
    var uo = ["................",
              "........5.......",
              "......14441.....",
              "....121444122...",
              "...11214441222..",
              "..1112111112222.",
              ".111121111122222",
              ".111.211.112.222",
              "........3.......",
              "........3.......",
              "........3.......",
              "........3.......",
              "........3.......",
              ".....3..3.......",
              "......33........"]
    var uz = ["................",
              "........5.......",
              "........4.......",
              "........4.......",
              ".......112......",
              ".......112......",
              ".......333......",
              ".......112......",
              ".......112......",
              ".......112......",
              ".......112......",
              "........3.......",
              "........3.......",
              ".....3..3.......",
              "......33........"]
    var up = [0xE23A4E, 0xA0202E, 0xB8BCC6, 0xFF8492, 0xE8ECF2]
    self.L["uo"] = self.pix(uo, up)
    self.L["uz"] = self.pix(uz, up)
    self.ut = []                                 # first canopy row per column: where drops land
    for x : 0 .. 15
      var y = 0
      while y < 8 && uo[y][x] == "." y += 1 end
      self.ut.push(y < 8 ? y : 16)
    end
    # Sunrise symbol: half sun over the horizon (row 12), anti-aliased, hot centre to orange rim
    var C = []
    var A = []
    for y : 0 .. 11
      for x : 0 .. 15
        var n = 0
        for sy : 0 .. 2
          for sx : 0 .. 2
            var dx = x + (sx + 0.5) / 3 - 8.0
            var dy = y + (sy + 0.5) / 3 - 12.0
            if dx * dx + dy * dy <= 27.0 n += 1 end
          end
        end
        var d = math.sqrt((x + 0.5 - 8.0) * (x + 0.5 - 8.0) + (y + 0.5 - 12.0) * (y + 0.5 - 12.0)) / 5.2
        A.push(n < 2 ? 0.0 : n / 9.0)
        C.push(self.mix(0xFFF4B0, 0xFF7A00, clamp(d * d, 0, 1)))
      end
    end
    self.L["hs"] = [0, 0, 16, 12, C, A]
    # Compass ring for the wind page: soft circle, north marked red, east/south/west light
    C = []
    A = []
    for y : 0 .. 15
      for x : 0 .. 15
        var d = math.sqrt((x - 7.5) * (x - 7.5) + (y - 7.5) * (y - 7.5)) - 7.3
        var c = 0x46546A
        var a = clamp(1 - (d < 0 ? -d : d), 0, 1)
        if (x == 7 || x == 8) && (y <= 1 || y >= 15)
          c = y <= 1 ? 0xFF3A2A : 0xA8B2C0
          a = y == 1 ? 0.8 : 1.0
        elif (y == 7 || y == 8) && (x == 0 || x == 15)
          c = 0xA8B2C0
          a = 1.0
        end
        C.push(c)
        A.push(a < 0.1 ? 0 : a)
      end
    end
    self.L["wr"] = [0, 0, 16, 16, C, A]
    # Wind streaks as pixel paths (x, y, ...) ending in a curl; lightning bolt; night stars x, y
    self.wp = [[1,4, 2,4, 3,4, 4,4, 5,4, 6,4, 7,4, 8,4, 9,4, 10,4, 11,3, 11,2, 10,1, 9,2],
               [0,8, 1,8, 2,8, 3,8, 4,8, 5,8, 6,8, 7,8, 8,8, 9,8, 10,8, 11,8, 12,8, 13,7, 14,6, 14,5, 13,4, 12,5],
               [2,12, 3,12, 4,12, 5,12, 6,12, 7,12, 8,12, 9,12, 10,13, 10,14, 9,15, 8,14]]
    self.bolt = [9,8, 8,9, 7,10, 8,10, 9,10, 8,11, 7,12, 6,13]
    # Sun rays: x, y, diagonal?, outer?  - big sun (disc around 8,8) and small sun (around 11,5)
    self.rb = [7,1,0,0, 8,1,0,0, 7,0,0,1, 8,0,0,1,  7,14,0,0, 8,14,0,0, 7,15,0,1, 8,15,0,1,
               1,7,0,0, 1,8,0,0, 0,7,0,1, 0,8,0,1,  14,7,0,0, 14,8,0,0, 15,7,0,1, 15,8,0,1,
               2,2,1,0, 1,1,1,1, 13,2,1,0, 14,1,1,1, 2,13,1,0, 1,14,1,1, 13,13,1,0, 14,14,1,1]
    self.rs8 = [10,0,0,1, 11,0,0,1, 6,4,0,1, 6,5,0,1, 15,4,0,1, 15,5,0,1, 7,1,1,1, 14,1,1,1, 7,8,1,1, 14,8,1,1]
    self.sk = [12,4, 14,1, 15,9, 9,1, 13,13, 2,1]

    # Moon pictures by LeonCB (AWTRIX Hub, awtrix.de/icons/full-moon etc.); the clouds follow his rainy-2 icon.
    # Two of his moon pictures as RRGGBB hex, 16x16: new moon (texture of the dark side) and full moon
    # (the lit side); every phase in between is computed from them
    self.mh = [
             "",
             ""]
    self.mi = -1
    self.mf = 0.0
    self.mpg = nil
    self.mpw = 0
    self.mc5 = self.grad(0xF0E6C8)
    self.mc5f = [0, 0, 0, 0, 0]
    self.mimg = nil
    self.mr = -1
    self.mst = -1
    self.rs = "--:--"
    self.ss = "--:--"
    self.nev = 0
    self.mtw = 19

    # Last known weather survives a reboot
    self.traw = store.get("temp")
    self.hraw = store.get("hum_v")
    self.hum = store.get("hum")
    self.hcol = store.get("hcol")
    self.nar = false
    self.ly = 0
    self.hr = store.get("hr", [])
    self.wk = store.get("wk", -1)
    self.wh = store.get("wh", 0)                 # 1/2: dry right now, but rain/snow showers about
    self.mday = -1
    self.mhr = -1
    self.mmin = -1
    self.ticks = 0
    self.age = 9999
    self.busy = false
    self.t0 = now_ms()
    self.tid = nil
    # Pages in knob order: 0 weather, 1 rain, 5 wind, 4 three days, 3 sun, 2 moon
    self.pages = [0]
    if store.get("rain") self.pages.push(1) end
    if store.get("windp") self.pages.push(5) end
    if store.get("fcst") self.pages.push(4) end
    if store.get("sunp") self.pages.push(3) end
    if self.moon self.pages.push(2) end
    self.sr = store.get("sr")
    self.su = store.get("su")
    self.srs = "--:--"
    self.sss = "--:--"
    self.snev = 0
    self.stw = 19
    self.fd = store.get("fd", [])
    self.fdd = []
    self.pi = 0
    self.pp = -1
    self.ps = now_ms()
    self.tp = 0
    self.ts = -99999
    self.mp = store.get("mp")
    self.mt0 = store.get("mt0", 0)
    self.rbh = []
    self.rbc = []
    self.rtk = []
    for i : 0 .. 11 self.rbh.push(0) self.rbc.push(0) self.rtk.push(false) end
    self.rtt = "..."
    self.rtc = 0x666666
    self.rtx = 30
    self.rst = 0
    self.qi = store.get("qi", 1.0)
    self.sl = store.get("sl", 0.0)
    self.wsv = store.get("wsv", 0)
    self.rq = 0
    self.bh = -2
    self.nx = -1
    self.today = true
    self.fx = []
    self.ay = []
    self.ac = []
    self.ad = []
    self.ab = []
    self.tm = -1
    self.tn = -1
    # Wind colours in km/h: calm grey-blue, light cyan, green, yellow, orange, red (gale), violet (storm)
    self.wst = [0, 0x8C9CB0, 8, 0x40C8E0, 20, 0x6ED228, 39, 0xFFE028, 50, 0xF8901F, 62, 0xF03A27, 89, 0xB040E0]
    self.wunit = store.get("wunit")
    self.wdv = store.get("wdv")
    self.wgv = store.get("wgv")
    self.whr = store.get("whr", [])
    self.wgr = store.get("wgr", [])
    self.wv = []
    self.wb = []
    self.wc5f = [0, 0, 0, 0, 0]
    self.wnc = 0xFFFFFF
    self.layout()
    self.fcalc()
    self.wcalc()
  end

  # ---------- helpers ----------
  def col(c, f)
    if f <= 0 return 0 end
    if f >= 1 return c end
    return (int(((c >> 16) & 255) * f) << 16) | (int(((c >> 8) & 255) * f) << 8) | int((c & 255) * f)
  end

  def mix(a, b, f)
    if f <= 0 return a end
    if f >= 1 return b end
    return (int(((a >> 16) & 255) + (((b >> 16) & 255) - ((a >> 16) & 255)) * f) << 16) |
           (int(((a >> 8) & 255) + (((b >> 8) & 255) - ((a >> 8) & 255)) * f) << 8) |
           int((a & 255) + ((b & 255) - (a & 255)) * f)
  end

  def ez(t)
    t = clamp(t, 0.0, 1.0)
    return t * t * (3 - 2 * t)
  end

  def fr(x)
    return x - math.floor(x)
  end

  # Shape -> layer [x0, y0, w, h, colours, alphas]; shade 0..1 runs from lo to hi
  def tint(x0, y0, w, h, hex, lo, hi)
    var b = bytes(hex)
    var C = []
    var A = []
    for i : 0 .. w * h - 1
      A.push(b[i * 2] / 255.0)
      C.push(self.mix(lo, hi, b[i * 2 + 1] / 255.0))
    end
    return [x0, y0, w, h, C, A]
  end

  # Pixel-art rows -> layer at 0, 0; digit = palette index + 1, anything else empty
  def pix(rows, pal)
    var C = []
    var A = []
    for r : rows
      for i : 0 .. size(r) - 1
        var k = r[i] >= "1" && r[i] <= "9" ? int(r[i]) - 1 : -1
        C.push(k < 0 ? 0 : pal[k])
        A.push(k < 0 ? 0 : 1.0)
      end
    end
    return [0, 0, size(rows[0]), size(rows), C, A]
  end

  # Icon buffer onto the panel at ox, oy with brightness f
  def out(ox, oy, f)
    var fb = self.fb
    for i : 0 .. 255
      var c = fb[i]
      if c pixel(i % 16 + ox, i / 16 + oy, f < 1 ? self.col(c, f) : c) end
    end
  end

  # Blend colour c into the icon buffer at x, y with opacity a
  def pt(x, y, c, a)
    if x < 0 || x > 15 || y < 0 || y > 15 || a <= 0.02 return end
    var j = y * 16 + x
    self.fb[j] = a >= 0.98 ? c : self.mix(self.fb[j], c, a)
  end

  # Sub-pixel point: spread over the four neighbours - smooth motion on 16 px
  def sp(x, y, c, a)
    var ix = int(math.floor(x))
    var iy = int(math.floor(y))
    var u = x - ix
    var v = y - iy
    self.pt(ix, iy, c, a * (1 - u) * (1 - v))
    self.pt(ix + 1, iy, c, a * u * (1 - v))
    self.pt(ix, iy + 1, c, a * (1 - u) * v)
    self.pt(ix + 1, iy + 1, c, a * u * v)
  end

  def lay(n, dx, dy, a)
    var L = self.L[n]
    var C = L[4]
    var A = L[5]
    var x0 = L[0] + dx
    var y0 = L[1] + dy
    var i = 0
    for y : y0 .. y0 + L[3] - 1
      for x : x0 .. x0 + L[2] - 1
        if A[i] > 0 self.pt(x, y, C[i], A[i] * a) end
        i += 1
      end
    end
  end

  # ---------- weather symbol pieces ----------
  # Sun: crisp rays on whole pixels, straight and diagonal ones breathing in turn; a glint circles the disc
  def sun(big, t)
    var R = big ? self.rb : self.rs8
    var pa = 0.5 + 0.5 * math.sin(t * 2.6)
    var i = 0
    while i < size(R)
      var a = R[i + 2] == 0 ? pa : 1 - pa             # 0 straight, 1 diagonal
      var o = R[i + 3]                                 # 0 inner pixel, 1 outer pixel
      self.pt(R[i], R[i + 1], o ? 0xFF9A10 : 0xFFC830, o ? a : 0.55 + 0.45 * a)
      i += 4
    end
    self.lay(big ? "su" : "ss", 0, 0, 1)
    var cx = big ? 7.5 : 10.5
    var cy = big ? 7.5 : 4.5
    var r = big ? 3.1 : 2.0
    self.sp(cx + r * math.cos(t * 1.3), cy + r * math.sin(t * 1.3), 0xFFFFFF, 0.55)
  end

  # Stars twinkle, n of them
  def stars(n, t)
    var k = self.sk
    for i : 0 .. n - 1
      var w = 0.5 + 0.5 * math.sin(t * (1.3 + i * 0.37) + i * 2.1)
      self.pt(k[i * 2], k[i * 2 + 1], i % 2 ? 0xB8C8FF : 0xFFFFFF, 0.15 + 0.85 * w * w)
    end
  end

  # Falling particles from row y0 down: kind 0 rain drop, 1 snowflake, 2 hail, 3 drizzle.
  # The count follows the real amount (qi), wind slants them (sl px sideways per px down).
  def fall(n, o, x0, w, y0, spd, c, k, t)
    var r = self.rn
    var span = 18.0 - y0
    var sl = self.sl
    n = clamp(int(n * self.qi + 0.5), 2, 15)
    spd = spd * (0.85 + 0.15 * self.qi)
    for i : 0 .. n - 1
      var y = y0 + (t * spd * (0.8 + 0.4 * r[i + o + 16]) + r[i + o + 32] * span) % span
      var yy = int(y + 0.5)                      # whole pixels stay crisp on the LEDs
      var x = int(x0 + r[i + o] * w + sl * (y - y0) + 16.5) % 16
      if k == 0
        self.pt(x, yy, c, 1.0)
        self.pt(int(x - sl + 0.5), yy - 1, c, 0.45)
        self.pt(int(x - 2 * sl + 0.5), yy - 2, c, 0.15)
        if yy == 16
          self.pt(x - 1, 15, c, 0.45)
          self.pt(x + 1, 15, c, 0.45)
        end
      elif k == 1
        var fx = x + int(math.sin(t * 2.2 + i * 2.3) * 1.2 + 10.5) - 10
        self.pt(fx, yy, c, 1.0)
        if i % 3 == 0                              # a few bigger flakes with soft arms
          self.pt(fx - 1, yy, c, 0.35) self.pt(fx + 1, yy, c, 0.35)
          self.pt(fx, yy - 1, c, 0.35) self.pt(fx, yy + 1, c, 0.35)
        end
      elif k == 2
        if yy > 15 yy = 15 - (yy - 15) * 2 end    # stones bounce off the ground
        self.pt(x, yy, c, 1.0)
      else
        self.pt(x, yy, c, 0.8)
      end
    end
  end

  # Dry for now, showers about: every 3 s one pale drop (or flake) drifts out of the cloud
  def hint(y0, dr, t)
    if self.wh == 0 return end
    var u = t % 3.0
    if u > 1.6 return end
    var a = u < 0.3 ? u / 0.3 : 1 - (u - 0.3) / 1.3
    var x = 5 + dr + (self.wh == 2 ? int(math.sin(t * 2.5) + 10.5) - 10 : 0)
    self.pt(x, int(y0 + u * 2.2 + 0.5), self.wh == 2 ? 0xE8F0FF : 0x5AA0F0, a)
  end

  # The weather symbol k into the buffer; t = seconds
  def icon(k, t)
    var fb = self.fb
    for i : 0 .. 255 fb[i] = 0 end
    var dr = math.sin(t * (0.6 + min(self.wsv, 50) / 30.0)) > 0 ? 1 : 0   # clouds drift by 1 px, faster in wind
    if k == 0
      self.sun(true, t)
    elif k == 1
      self.stars(6, t)
      var u = t % 7.0                                  # shooting star every 7 s
      if u < 0.7
        for j : 0 .. 4 self.sp(15.5 - u * 16 + j * 1.1, 8.5 + u * 7 - j * 0.48, 0xFFFFFF, (1 - u / 0.7) * (1 - j * 0.2)) end
      end
      self.lay("mo", 0, 0, 1)
    elif k == 2
      self.sun(false, t)
      self.lay("sl", dr, 6, 1)
      self.hint(11, dr, t)
    elif k == 13
      self.stars(3, t)
      self.lay("ms", 0, 0, 1)
      self.lay("sl", dr, 6, 1)
      self.hint(11, dr, t)
    elif k == 3
      self.lay("kl", 1 - dr, 2, 1)
      self.lay("sl", dr, 8, 1)
      self.hint(13, dr, t)
    elif k == 4
      for r : 0 .. 4
        for x : 0 .. 15
          var v = 0.5 + 0.5 * math.sin(x * 0.55 + t * (r % 2 ? 1.3 : -1.0) + r * 1.7)
          self.pt(x, 2 + r * 3, 0xC8CED8, 0.2 + 0.7 * v * v)
        end
      end
    elif k == 5
      self.fall(6, 0, 2, 12, 6, 4.5, 0x9CCBFF, 3, t)
      self.lay("cl", dr, 1, 1)
    elif k == 6
      self.fall(10, 0, 1, 14, 6, 10.0, 0x4A9CFF, 0, t)
      self.lay("cd", dr, 1, 1)
    elif k == 7 || k == 12
      if k == 7 self.sun(false, t) else self.stars(3, t) self.lay("ms", 0, 0, 1) end
      self.fall(6, 3, 1, 10, 6, 9.0, 0x4A9CFF, 0, t)
      self.lay("sl", dr, 4, 1)
    elif k == 8
      self.fall(10, 0, 1, 14, 6, 2.6, 0xFFFFFF, 1, t)
      self.lay("cl", dr, 1, 1)
    elif k == 9
      var u = t % 3.4                                  # double flash
      var fl = u < 0.09 || (u > 0.2 && u < 0.36)
      self.fall(6, 5, 1, 14, 6, 10.0, 0x3A6CC0, 0, t)
      var b = self.bolt
      var ba = fl ? 1.0 : (u > 0.36 && u < 0.6 ? 0.5 : 0)
      for j : 0 .. 7
        if fl self.sp(b[j * 2] - 0.5, b[j * 2 + 1], 0xFFE060, 0.25) self.sp(b[j * 2] + 0.5, b[j * 2 + 1], 0xFFE060, 0.25) end
        self.pt(b[j * 2], b[j * 2 + 1], fl ? 0xFFFBD0 : 0xFFD000, ba)
      end
      self.lay(fl ? "cf" : "ct", dr, 1, 1)
    elif k == 10
      self.fall(8, 0, 1, 14, 6, 13.0, 0xDDF4FF, 2, t)
      self.lay("cd", dr, 1, 1)
    elif k == 11
      for j : 0 .. 2
        var p = self.wp[j]
        var n = size(p) / 2
        var h = (t * (8 + min(self.wsv, 80) / 5.0) + j * 7) % (n + 9.0)   # gusts run faster in stronger wind
        for i : 0 .. n - 1
          var d = h - i
          var a = d >= 0 && d < 6 ? 1.0 - d / 6.0 : 0
          self.pt(p[i * 2], p[i * 2 + 1], self.mix(0x7FA8BC, 0xF4FCFF, a), 0.4 + 0.6 * a)
        end
      end
    elif k == 14
      self.fall(5, 0, 1, 14, 6, 9.0, 0x4A9CFF, 0, t)
      self.fall(5, 9, 2, 12, 6, 2.6, 0xFFFFFF, 1, t)
      self.lay("cd", dr, 1, 1)
    end
  end

  # ---------- weather data ----------
  # Colour of v from stops (lower bound, colour, ...) - the temperature stops unless s is given
  def colour(v, s)
    if s == nil s = self.st end
    var n = size(s) - 2
    if v <= s[0] return s[1] end
    var j = 0
    while j < n && v >= s[j + 2] j += 2 end
    if j >= n return s[n + 1] end
    return self.mix(s[j + 1], s[j + 3], (v - s[j]) * 1.0 / (s[j + 2] - s[j]))
  end

  # Glyphs, position and 5-step colour gradient of the temperature - once per update
  def layout()
    self.tg = nil
    self.tu = nil
    self.hg = nil
    if self.traw == nil return end
    var f = self.unit == "F"
    var solo = self.hraw == nil || self.hum == "off" || self.hum == "alternate"   # temperature on its own
    var v = f ? self.traw * 1.8 + 32 : self.traw
    var r = int(v + (v >= 0 ? 0.5 : -0.5))
    var g = []
    if r < 0 g.push(10) end
    var s = str(r < 0 ? -r : r)
    for i : 0 .. size(s) - 1 g.push(int(s[i])) end
    if f && !solo g.push(12) end
    self.tg = g
    if solo self.tu = [f ? 12 : 13] end          # on its own: ° ring and unit, "11°C"
    var deg = f && !solo ? 0 : 4                 # the ° ring: 3 px plus a gap
    self.nar = false
    var tw = self.wid(g, false) - 1 + deg + (solo ? 7 : 0)
    self.tx = 17 + (35 - tw) / 2
    self.tc5 = self.grad(self.colour(self.traw))
    if self.hraw == nil || self.hum == "off" return end

    g = []
    s = str(int(self.hraw + 0.5))
    for i : 0 .. size(s) - 1 g.push(int(s[i])) end
    g.push(11)
    self.hg = g
    self.hc5 = self.grad(self.hcol)
    if self.hum == "alternate"
      self.hx = 17 + (35 - (self.wid(g, false) - 1)) / 2
      return
    end
    # Side by side in the 35 columns: full size, else narrow digits, else narrow without %
    var hw = self.wid(g, false) - 1
    if tw + 3 + hw > 35
      self.nar = true
      tw = self.wid(self.tg, true) - 1 + deg
      hw = self.wid(g, true) - 1
      if tw + 2 + hw > 35
        g.pop()
        hw -= 6
      end
    end
    var gap = self.nar ? 2 : 3
    self.tx = 17 + (35 - tw - gap - hw) / 2
    self.hx = self.tx + tw + gap
  end

  # Width of a glyph list: 7 px per glyph (6 narrow), the slim 1 only 5
  def wid(g, nar)
    var w = 0
    for d : g w += d == 1 ? 5 : (nar ? 6 : 7) end
    return w
  end

  # 5-step vertical gradient for the block digits: lighter top, darker bottom
  def grad(c)
    var l = []
    for i : 0 .. 4 l.push(self.mix(self.mix(c, 0xFFFFFF, 0.18), self.col(c, 0.62), i / 4.0)) end
    return l
  end

  # Graph values for the current hour: 24 values over the columns 17-51, rows 11-15
  def build()
    var h0 = hour()
    self.bh = h0
    var N = size(self.hr)
    if N < 2 return end
    var nxt = self.view == "next24" || (self.view == "auto" && h0 >= 18)
    self.today = !nxt
    var a = nxt && h0 > 0 ? h0 : 0
    if N - a < 2 a = 0 end
    var n = N - a > 24 ? 24 : N - a
    var lo = 999
    var hi = -999
    var fc = []
    for i : 0 .. n - 1
      var v = self.hr[a + i]
      if v < lo lo = v end
      if v > hi hi = v end
      fc.push(self.colour(v))
    end
    var span = hi - lo
    var fy = []
    self.fx = []
    for i : 0 .. n - 1
      var dy = span <= 0 ? 2 : int((self.hr[a + i] - lo) * 4.0 / span + 0.5)
      fy.push(15 - clamp(dy, 0, 4))
      self.fx.push(17 + i * 34 / (n - 1))
    end
    self.ay = []
    self.ac = []
    self.ad = []
    self.ab = []
    var i = 0
    for x : 17 .. 51
      while i < n - 2 && x > self.fx[i + 1] i += 1 end
      var q = (x - self.fx[i]) * 1.0 / (self.fx[i + 1] - self.fx[i])
      var c = self.mix(fc[i], fc[i + 1], q)
      self.ay.push(int(fy[i] + (fy[i + 1] - fy[i]) * q + 0.5))
      self.ac.push(c)
      self.ad.push(self.col(c, 0.3))
      self.ab.push(self.col(c, 0.75))
    end
    self.tm = -1
    self.tn = -1
    var im = (24 - a) % 24
    var inn = (36 - a) % 24
    if nxt && im > 0 && im < n self.tm = self.fx[im] end
    if inn < n self.tn = self.fx[inn] end
  end

  def on_body(w, status)
    self.busy = false
    self.ticks = 60                              # no usable answer: try again in a minute
    self.hst = status == nil ? 0 : status
    if w == nil return end
    var m = re.search("_2m\":([-0-9.]+)", w)
    var c = re.search("code\":(\\d+)", w)
    var h = re.search("_2m\":\\[([^\\]]*)", w)
    var dm = re.search("is_day\":(\\d)", w)
    var wm = re.search("wind_speed_10m\":([0-9.]+)", w)
    var cm = re.search("cloud_cover\":(\\d+)", w)
    var sm = re.search("sunshine_duration\":\\[([0-9.]+)", w)
    var hm = re.search("humidity_2m\":([0-9.]+)", w)
    var pm = re.search("precipitation\":([0-9.]+)", w)        # mm in these 15 minutes
    var dw = re.search("wind_direction_10m\":(\\d+)", w)
    var mt = re.search("minutely_15\":.\"time\":\\[(\\d+)", w)
    var mq = re.search("precipitation\":\\[([^\\]]*)", w)
    if m == nil || c == nil || h == nil return end
    var t = num(m[1])
    if t == nil return end
    var hr = []
    for s : re.matchall("[-0-9.]+", h[1])
      var v = num(s)
      hr.push(v == nil ? t : v)
    end
    if size(hr) < 2 return end
    if hm != nil && num(hm[1]) != nil               # humidity is optional, never blocks the rest
      self.hraw = num(hm[1])
      store.set("hum_v", self.hraw)
    end
    self.traw = t
    self.hr = hr
    self.layout()
    self.build()

    # Symbols: 0 clear, 1 clear night, 2 partly, 3 cloudy, 4 fog, 5 drizzle, 6 rain, 7 showers,
    # 8 snow, 9 thunder, 10 hail, 11 windy, 12 showers at night, 13 partly at night, 14 sleet
    var k = int(num(c[1]))
    var day = dm == nil || dm[1] == "1"
    var cc = cm == nil ? nil : num(cm[1])
    var sun = sm != nil && num(sm[1]) != nil && num(sm[1]) >= 450
    var ic = 3
    if k <= 3 && cc != nil
      if cc >= self.cloud && !(day && sun)  ic = 3
      elif cc >= self.cloud / 2              ic = day ? 2 : 13
      else                                   ic = day ? 0 : 1
      end
    elif k == 0         ic = day ? 0 : 1
    elif k <= 2         ic = day ? 2 : 13
    elif k == 3         ic = 3
    elif k <= 48        ic = 4
    elif k == 56 || k == 57 || k == 66 || k == 67  ic = 14
    elif k <= 57        ic = 5
    elif k <= 67        ic = 6
    elif k <= 77        ic = 8
    elif k <= 82        ic = day ? 7 : 12
    elif k <= 86        ic = 8
    elif k == 95        ic = 9
    elif k >= 96        ic = 10
    end
    var ws = wm == nil ? nil : num(wm[1])
    if k <= 48 && ws != nil && ws >= self.wind ic = 11 end
    # Rain, snow or showers in the code but nothing falling right now: the dry symbol by cloud cover,
    # with a hint drop (or flake). Thunderstorms always stay.
    var wh = 0
    var pr = pm == nil ? nil : num(pm[1])
    if k >= 51 && k <= 86 && pr != nil && pr <= 0
      wh = (k >= 71 && k <= 77) || k >= 85 ? 2 : 1
      ic = cc != nil && cc >= self.cloud ? 3 : (day ? 2 : 13)
    end
    self.wh = wh
    store.set("wh", wh)
    # Amount and wind for the falling particles; wind from the west slants them to the right
    self.qi = pr == nil || pr <= 0 ? 1.0 : clamp(0.6 + pr * 0.8, 0.6, 1.6)
    self.wsv = ws == nil ? 0 : ws
    var wd = dw == nil ? nil : num(dw[1])
    self.sl = ws == nil || wd == nil ? 0.0 : -math.sin(wd * 0.0174533) * clamp((ws - 5) / 45.0, 0, 1) * 0.8
    store.set("qi", self.qi)
    store.set("sl", self.sl)
    store.set("wsv", self.wsv)
    # Wind page: direction, gusts now, hourly wind and gusts
    if wd != nil
      self.wdv = wd
      store.set("wdv", wd)
    end
    var gm = re.search("wind_gusts_10m\":([0-9.]+)", w)
    self.wgv = gm == nil ? nil : num(gm[1])
    if self.wgv != nil store.set("wgv", self.wgv) end
    for j : 0 .. 1
      var mm = re.search((j == 0 ? "wind_speed" : "wind_gusts") + "_10m\":\\[([^\\]]*)", w)
      if mm != nil
        var l = []
        for s : string.split(mm[1], ",") l.push(num(s, 0)) end
        if j == 0 self.whr = l else self.wgr = l end
        store.set(j == 0 ? "whr" : "wgr", l)
      end
    end
    self.wcalc()
    # Rain of the next hours in 15-minute steps
    if mt != nil && mq != nil
      var l = []
      for s : re.matchall("[0-9.]+", mq[1]) l.push(num(s)) end
      if size(l) >= 4
        self.mp = l
        self.mt0 = int(num(mt[1]))
        store.set("mp", l)
        store.set("mt0", self.mt0)
      end
    end
    self.rcalc()
    # Daily: sunrise/sunset of today and the next days, forecast for tomorrow and two more days
    var dt = re.search("daily\":.\"time\":\\[([^\\]]*)", w)
    var da = []
    for key : ["weather_code", "temperature_2m_max", "temperature_2m_min", "sunrise", "sunset", "probability_max"]
      var mm = re.search(key + "\":\\[([^\\]]*)", w)
      var l = []
      if mm != nil for s : string.split(mm[1], ",") l.push(num(s)) end end
      da.push(l)
    end
    if dt != nil && size(da[3]) >= 2 && size(da[4]) >= 2
      self.sr = da[3]
      self.su = da[4]
      store.set("sr", self.sr)
      store.set("su", self.su)
    end
    if dt != nil && size(da[0]) >= 4 && size(da[1]) >= 4 && size(da[2]) >= 4
      var tl = string.split(dt[1], ",")
      var fd = []
      for i : 1 .. 3 fd.push([da[0][i], da[1][i], da[2][i], i < size(da[5]) ? da[5][i] : nil, num(tl[i])]) end
      self.fd = fd
      store.set("fd", fd)
    end
    self.scalc()
    self.fcalc()
    self.wk = ic
    self.age = 0
    self.ticks = 15 * 60
    self.hst = nil
    store.set("temp", t)
    store.set("wk", ic)
    store.set("hr", hr)
  end

  # ---------- moon ----------
  # Picture for the phase now, with the same windows as Home Assistant's moon sensor. The phase is the
  # moon's true elongation from the sun (0 new, 0.5 full), so the lit share matches the real moon.
  def phase()
    var el = self.alt(epoch_ms() / 1000, true)
    self.mf = el[0]
    self.mpic(el[1], self.mf < 0.5)
  end

  # Lit share lit (0..1) -> % glyphs and the moon picture for exactly that share. The picture is computed:
  # LeonCB's full moon is the lit side, the new moon's texture stretched into a cool grey (earthshine) the
  # dark side. Between them the terminator, per row an ellipse at x = (1 - 2 * share) * half width, soft
  # over 4x4 sub-pixels. Waxing = right side lit; south of the equator mirrored. Only redrawn when the % changes.
  def mpic(lit, wax)
    var p = int(lit * 100 + 0.5)
    var ps = str(p)
    var g = []
    for j : 0 .. size(ps) - 1 g.push(int(ps[j])) end
    g.push(11)
    self.mpg = g
    self.mpw = self.wid(g, false) - 1
    if self.lat < 0 wax = !wax end
    var key = p * 2 + (wax ? 1 : 0)
    if key == self.mi return end
    self.mi = key
    var fl = bytes(self.mh[1])
    var n = bytes(self.mh[0])
    var mx = 1                                   # brightest pixel of the new moon picture
    for j : 0 .. 255 mx = max(mx, n[j * 3] + n[j * 3 + 1] + n[j * 3 + 2]) end
    var k = 1 - p / 50.0
    var hw = []                                  # half width of the disc per sub-row
    for q : 0 .. 63
      var dy = (q + 0.5) / 4 - 8.0
      hw.push(math.sqrt(max(0.0, 63.0 - dy * dy)))
    end
    var m = []
    for j : 0 .. 255
      var x = j % 16
      var y = j / 16
      var s = n[j * 3] + n[j * 3 + 1] + n[j * 3 + 2]
      var r = fl[j * 3]
      var gg = fl[j * 3 + 1]
      var bl = fl[j * 3 + 2]
      if s > 0 || r + gg + bl > 0
        var cv = 0
        var li = 0.0
        for sy : 0 .. 3
          var w = hw[y * 4 + sy]
          var dy = y + (sy + 0.5) / 4 - 8.0
          for sx : 0 .. 3
            var dx = x + (sx + 0.5) / 4 - 8.0
            if dx * dx + dy * dy <= 63.0
              cv += 1
              var d = ((wax ? dx : -dx) - k * w) / (0.08 * w + 0.5) + 0.5
              li += d < 0 ? 0.0 : (d > 1 ? 1.0 : d)
            end
          end
        end
        var a = cv / 16.0
        var L = cv > 0 ? li / cv : 0.0
        var f = math.pow(s * 1.0 / mx, 1.3)
        var er = (22 + 68 * f) * a
        var eg = (24 + 70 * f) * a
        var eb = (30 + 74 * f) * a
        r = int(er + (max(r, er) - er) * L)
        gg = int(eg + (max(gg, eg) - eg) * L)
        bl = int(eb + (max(bl, eb) - eb) * L)
      end
      m.push((r << 16) | (gg << 8) | bl)
    end
    self.mimg = m
  end

  # Moon height above the horizon at unix time u (seconds), as sin(altitude) minus the rise/set
  # limit: low-precision lunar theory (Montenbruck & Pfleger), good to about a minute.
  # With el: [phase 0..1 of the cycle from the longitudes (0 new, 0.5 full), lit share 0..1 from the
  # true elongation, latitude included].
  def alt(u, el)
    var e = u - 946728000                       # since 2000-01-01 12:00 UTC
    var fd = (e % 86400) / 86400.0
    var d = (e / 86400) + fd
    var T = d / 36525
    var P = 6.283185307
    var s = math.sin
    var c = math.cos
    var L0 = self.fr(0.606433 + 1336.855225 * T)
    var l = P * self.fr(0.374897 + 1325.552410 * T)
    var ls = P * self.fr(0.993133 + 99.997361 * T)
    var D = P * self.fr(0.827361 + 1236.853086 * T)
    var F = P * self.fr(0.259086 + 1342.227825 * T)
    var dL = 22640 * s(l) - 4586 * s(l - 2 * D) + 2370 * s(2 * D) + 769 * s(2 * l) - 668 * s(ls) -
             412 * s(2 * F) - 212 * s(2 * l - 2 * D) - 206 * s(l + ls - 2 * D) + 192 * s(l + 2 * D) -
             165 * s(ls - 2 * D) - 125 * s(D) - 110 * s(l + ls) + 148 * s(l - ls) - 55 * s(2 * F - 2 * D)
    var S = F + (dL + 412 * s(2 * F) + 541 * s(ls)) / 206264.8062
    var h = F - 2 * D
    var N = -526 * s(h) + 44 * s(l + h) - 31 * s(h - l) - 23 * s(ls + h) + 11 * s(h - ls) -
            25 * s(F - 2 * l) + 21 * s(F - l)
    var lm = P * self.fr(L0 + dL / 1296000)
    var bm = (18520 * s(S) + N) / 206264.8062
    if el
      var dl = lm - P * self.fr(0.7859453 + ls / P + (6893 * s(ls) + 72 * s(2 * ls) + 6191.2 * T) / 1296000)
      return [self.fr(dl / P), (1 - c(bm) * c(dl)) / 2]
    end
    var x = c(bm) * c(lm)
    var y = c(bm) * s(lm)
    var z = s(bm)
    var ra = math.atan2(y * 0.917482 - z * 0.397777, x)
    var de = math.asin(y * 0.397777 + z * 0.917482)
    var ha = (280.46061837 + 360 * fd + 0.98564736629 * d + self.lon) * 0.0174532925 - ra
    var la = self.lat * 0.0174532925
    return s(la) * s(de) + c(la) * c(de) * c(ha) - 0.002327
  end

  def hm(m)
    if m < 0 return "--:--" end
    m = m % 1440
    if settings.get("time24h") == false          # 12-hour clock: 7:45A / 6:42P
      var h = m / 60 % 12
      return string.format("%d:%02d%s", h == 0 ? 12 : h, m % 60, m < 720 ? "A" : "P")
    end
    return string.format("%02d:%02d", m / 60, m % 60)
  end

  # First moonrise and moonset from today 0:00 on (today's, else tomorrow's), every 20 min + interpolation
  def mcalc()
    var e = epoch_ms()
    if e < 0 || hour() < 0 return end
    var t0 = e / 1000 - (hour() * 3600 + minute() * 60 + second())
    self.mr = -1
    self.mst = -1
    var p = self.alt(t0)
    for i : 1 .. 144
      var v = self.alt(t0 + i * 1200)
      if (p < 0) != (v < 0)
        var m = int(((i - 1) * 1200 + 1200 * p / (p - v)) / 60)
        if v >= 0 && self.mr < 0 self.mr = m end
        if v < 0 && self.mst < 0 self.mst = m end
      end
      p = v
      if self.mr >= 0 && self.mst >= 0 break end
    end
    self.rs = self.hm(self.mr)
    self.ss = self.hm(self.mst)
    self.mtw = text_ink_width(self.rs)
  end

  # ---------- rain page ----------
  # Bars and text for the next 3 hours (12 x 15 min) from the slot we are in now; once a minute
  def rcalc()
    var e = epoch_ms()
    if e < 0 || hour() < 0 || self.mp == nil return end
    var now = e / 1000
    var off = hour() * 3600 + minute() * 60 + second() - now % 86400   # local time minus UTC
    if off > 50400 off -= 86400 end
    if off < -43200 off += 86400 end
    var j = (now - self.mt0) / 900
    if j < 0 j = 0 end
    var n = size(self.mp)
    var first = -1
    var dry = -1
    var bh = []
    var bc = []
    var tk = []
    for i : 0 .. 11
      var k = j + i
      var mm = k < n ? self.mp[k] : 0
      if mm >= 0.1 && first < 0 first = i end
      if mm < 0.1 && dry < 0 && i > 0 dry = i end
      bh.push(mm < 0.05 ? 0 : clamp(int(math.ceil(8 * math.sqrt(min(mm, 2.5) / 2.5))), 1, 8))
      var f = clamp(mm / 2.5, 0, 1)
      bc.push(f < 0.5 ? self.mix(0x8CC8FF, 0x2F7CFF, f * 2) : self.mix(0x2F7CFF, 0x9A50F0, (f - 0.5) * 2))
      tk.push((self.mt0 + k * 900 + off) % 3600 == 0)
    end
    self.rbh = bh
    self.rbc = bc
    self.rtk = tk
    self.rq = j < n ? self.mp[j] : 0
    var s
    if first == 0                                # raining now: until when?
      self.rst = 2
      s = dry < 0 ? (self.de ? "> 3 STD" : "> 3 H") : (self.de ? "BIS " : "ENDS ") + self.hm(((self.mt0 + (j + dry) * 900 + off) % 86400) / 60)
      if text_ink_width(s) > 35 s = "-" + self.hm(((self.mt0 + (j + dry) * 900 + off) % 86400) / 60) end
      self.rtc = 0x8CC8FF
    elif first > 0                               # dry now: when does it start?
      self.rst = 1
      var m = (self.mt0 + (j + first) * 900 - now) / 60
      m = ((m < 1 ? 1 : m) + 4) / 5 * 5
      s = m < 60 ? "IN " + str(m) + " MIN" : (self.de ? "AB " : "AT ") + self.hm(((self.mt0 + (j + first) * 900 + off) % 86400) / 60)
      if text_ink_width(s) > 35 s = m < 60 ? "IN " + str(m) + "M" : self.hm(((self.mt0 + (j + first) * 900 + off) % 86400) / 60) end
      self.rtc = 0xFFFFFF
    else
      self.rst = 0
      s = self.de ? "TROCKEN" : "DRY"
      self.rtc = 0xFFD860
    end
    self.rtt = s
    self.rtx = 17 + (35 - text_ink_width(s)) / 2
  end

  # ---------- wind page ----------
  # Speed and gusts as block digits, direction (or "gusts") and unit beside them; the next 12 hours
  # as bars (mean wind, gusts as a faint bar above). Once per update and every hour.
  def wcalc()
    var u = self.wunit
    var ul = u == "m/s" ? "M/S" : (u == "mph" ? "MPH" : (u == "kn" ? "KN" : (u == "Bft" ? "BFT" : "KM/H")))
    var dl = self.de ? ["N", "NO", "O", "SO", "S", "SW", "W", "NW"] : ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]
    self.wnc = self.colour(self.wsv, self.wst)
    self.wv = []
    if self.wdv != nil                           # nothing known before the first update
      for j : 0 .. 1
        var v = j == 0 ? self.wsv : self.wgv
        if v == nil || (j == 1 && v < self.wsv + 3) continue end     # gusts only when they stand out
        var r = 0
        if u == "Bft"
          for b : [1, 6, 12, 20, 29, 39, 50, 62, 75, 89, 103, 118] if v >= b r += 1 end end
        else
          r = int(v / (u == "m/s" ? 3.6 : (u == "mph" ? 1.609 : (u == "kn" ? 1.852 : 1.0))) + 0.5)
        end
        var g = []
        var s = str(r)
        for i : 0 .. size(s) - 1 g.push(int(s[i])) end
        var lab = j == 1 ? (self.de ? "B\xC3\x96EN" : "GUST") : (self.wsv < 2 ? (self.de ? "STILL" : "CALM") : dl[int((self.wdv + 22.5) / 45) % 8])
        var lw = max(text_ink_width(lab), text_ink_width(ul))
        var nar = false
        var gw = self.wid(g, false) - 1
        if gw + 2 + lw > 35
          nar = true
          gw = self.wid(g, true) - 1
        end
        var x = max(17, 17 + (35 - gw - 2 - lw) / 2)
        self.wv.push({"g": g, "nar": nar, "c5": self.grad(self.colour(v, self.wst)), "x": x, "rx": x + gw + 2,
                      "lab": lab, "lc": j == 0 ? 0xF2F2F6 : 0xC8D0DC, "u": ul})
      end
    end
    # Bars: 5 rows for up to 75 km/h (square root, so light wind still shows), hourly data from 0:00
    self.wb = []
    var h = hour()
    if h < 0 return end
    for i : 0 .. 11
      var k = h + i
      var v = k < size(self.whr) ? self.whr[k] : nil
      var gv = k < size(self.wgr) ? self.wgr[k] : nil
      var hh = k % 24
      self.wb.push([v == nil ? 0 : 5 * math.sqrt(min(v, 75) / 75.0), v == nil ? 0 : self.colour(v, self.wst),
                    gv == nil ? 0 : int(5 * math.sqrt(min(gv, 75) / 75.0) + 0.5),
                    gv == nil ? 0 : self.col(self.colour(gv, self.wst), 0.3),
                    hh == 0 ? self.mcol : (hh == 12 ? self.ncol : 0)])
    end
  end

  # ---------- sun and forecast pages ----------
  # Local time minus UTC in seconds
  def tzo()
    var now = epoch_ms() / 1000
    var off = hour() * 3600 + minute() * 60 + second() - now % 86400
    if off > 50400 off -= 86400 end
    if off < -43200 off += 86400 end
    return off
  end

  # Sunrise and sunset of today; after today's sunset those of tomorrow. The next one is lit.
  def scalc()
    var e = epoch_ms()
    if e < 0 || hour() < 0 || self.sr == nil || size(self.sr) < 2 || size(self.su) < 2 return end
    var now = e / 1000
    var off = self.tzo()
    var i = now >= self.su[0] ? 1 : 0
    self.srs = self.hm(((int(self.sr[i]) + off) % 86400) / 60)
    self.sss = self.hm(((int(self.su[i]) + off) % 86400) / 60)
    self.snev = now < self.sr[i] ? 1 : (now < self.su[i] ? 2 : 0)
    self.stw = text_ink_width(self.srs)
  end

  # Weather code of a day -> symbol (daytime)
  def wkind(k)
    if k == nil return 3 end
    if k == 0 return 0 end
    if k <= 2 return 2 end
    if k == 3 return 3 end
    if k <= 48 return 4 end
    if k == 56 || k == 57 || k == 66 || k == 67 return 14 end
    if k <= 55 return 5 end
    if k <= 65 return 6 end
    if k <= 77 || k == 85 || k == 86 return 8 end
    if k <= 82 return 7 end
    if k == 95 return 9 end
    return 10
  end

  # Everything the forecast page draws per day, built once per update
  def fcalc()
    self.fdd = []
    if size(self.fd) == 0 || epoch_ms() < 0 || hour() < 0 return end
    var off = self.tzo()
    var wd = self.de ? ["SO", "MO", "DI", "MI", "DO", "FR", "SA"] : ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]
    var f = self.unit == "F"
    var j = 0
    for d : self.fd
      if d[1] == nil || d[2] == nil continue end
      var hi = f ? d[1] * 1.8 + 32 : d[1]
      var lo = f ? d[2] * 1.8 + 32 : d[2]
      var g = []
      var r = int(hi + (hi >= 0 ? 0.5 : -0.5))
      if r < 0 g.push(10) end
      var s = str(r < 0 ? -r : r)
      for i : 0 .. size(s) - 1 g.push(int(s[i])) end
      var bw = self.wid(g, false) - 1 + (f ? 0 : 4)
      var lr = int(lo + (lo >= 0 ? 0.5 : -0.5))
      var mn = str(lr) + (f ? "" : "°")
      var pr = d[3] != nil && d[3] >= 10 ? str(int(d[3])) + "%" : ""   # rain chance, top right
      var x = 17 + (35 - bw - 3 - text_ink_width(mn)) / 2
      var lab = "--"                              # weekday and date, or just the weekday next to the rain chance
      if d[4] != nil
        var dn = (int(d[4]) + off + 43200) / 86400       # days since 1970 (local noon)
        var z = dn + 719468                               # civil date from days
        var era = z / 146097
        var doe = z - era * 146097
        var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
        var doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
        var mp = (5 * doy + 2) / 153
        var dd = doy - (153 * mp + 2) / 5 + 1
        var mo = mp < 10 ? mp + 3 : mp - 9
        lab = wd[(dn + 4) % 7]
        if pr == "" lab += " " + (self.de ? string.format("%02d.%02d", dd, mo) : str(dd)) end
      end
      self.fdd.push({"k": self.wkind(d[0] == nil ? nil : int(d[0])), "g": g, "c5": self.grad(self.colour(d[1])),
                     "x": x, "rx": x + bw + 3, "mn": mn, "mc": self.colour(d[2]), "pr": pr, "px": 52 - text_ink_width(pr),
                     "lab": lab, "lc": j == 0 ? 0xF2F2F6 : 0xB8B8C4})
      j += 1
    end
  end

  # ---------- lifecycle ----------
  def loop()
    var h = hour()
    if h < 0 return end
    var d = day()
    if d != self.mday
      if self.mday >= 0 self.ticks = 0 end
      self.mday = d
      self.mcalc()
    end
    if h != self.mhr
      self.mhr = h
      self.build()
      self.wcalc()
    end
    var mi = h * 60 + minute()
    if mi != self.mmin
      self.mmin = mi
      self.phase()
      self.nx = self.today && size(self.ay) > 0 ? clamp(mi * 34 / 1380, 0, 34) : -1
      # Which moon event comes next - that one is lit, the other dimmed
      var r = self.mr > mi ? self.mr : 99999
      var s = self.mst > mi ? self.mst : 99999
      self.nev = r == s ? 0 : (r < s ? 1 : 2)
      self.rcalc()
      self.scalc()
    end
    self.age += 1
    if self.ticks <= 0 && !self.busy
      self.ticks = 15 * 60
      self.busy = true
      http.get(self.url, / b, st -> self.on_body(b, st), {'find': "\"current\":", 'keep': 8000})
    end
    self.ticks -= 1
  end

  # Auto mode (idea and first version by DennsDJ): how long one page stays. The 3-day forecast
  # needs 3 x 3.5 s, moon and wind 8 s so the lit share and the gusts (after 4 s) are seen too.
  def pdur(k)
    var d = self.psec
    if k == 4 && d < 10500 d = 10500 end
    if (k == 2 || k == 5) && d < 8000 d = 8000 end
    return d
  end

  def duration()
    if !self.auto return self.dur * 1000 end
    var d = 0
    for k : self.pages d += self.pdur(k) end
    return d
  end

  # Auto mode: the next page slides in; the last one stays until the rotation moves on
  def anext()
    self.atid = nil
    if self.pi >= size(self.pages) - 1 return end
    self.pp = self.pi
    self.tp = self.ps
    self.pi += 1
    self.ps = now_ms()
    self.ts = self.ps
    if self.pi < size(self.pages) - 1 self.atid = timer.after(self.pdur(self.pages[self.pi]), / -> self.anext()) end
  end

  def on_show()
    self.pi = 0                                  # always start with the weather
    self.pp = -1
    if self.atid != nil timer.cancel(self.atid) self.atid = nil end
    if self.auto && size(self.pages) > 1 self.atid = timer.after(self.pdur(0), / -> self.anext()) end
    self.ps = now_ms()
    self.ts = self.ps - 99999
  end

  def on_hide()
    if self.atid != nil
      timer.cancel(self.atid)
      self.atid = nil
    end
    if self.tid != nil
      timer.cancel(self.tid)
      self.tid = nil
      rotation.resume()
    end
  end

  # Knob: right = next page (weather -> rain -> wind -> ... -> moon), left = back. While someone turns it the
  # rotation waits; `hold` seconds after the last turn it moves on.
  def on_knob(ev)
    if self.auto || size(self.pages) < 2 || (ev != "left" && ev != "right") return false end   # auto: knob keeps brightness/volume
    var p = clamp(self.pi + (ev == "right" ? 1 : -1), 0, size(self.pages) - 1)
    if p != self.pi
      self.pp = self.pi
      self.tp = self.ps
      self.pi = p
      self.ps = now_ms()
      self.ts = self.ps
    end
    rotation.pause()
    if self.tid != nil timer.cancel(self.tid) end
    self.tid = timer.after(self.hold * 1000, def ()
      self.tid = nil
      rotation.resume()
      rotation.next()
    end)
    return true
  end

  # ---------- drawing ----------
  # Block digits 6x10 (narrow: middle column 1 px); i0 = position in the drop-in order
  def glyphs(g, x, g5, oy, t, i0, sw)
    var nar = self.nar
    var i = i0
    for d : g
      var e = clamp((t - 0.15 - i * 0.09) / 0.42, 0, 1)
      var q = e - 1
      var yo = int(math.floor((2.7 * q * q * q + 1.7 * q * q) * 11 + 0.5)) + oy
      self.ly = yo
      var b = d == 1 ? 0 : self.bm[d]
      for r : 0 .. 4
        for k : 0 .. 2
          var on = d == 1 ? (k == 1 || (k == 0 && r == 1)) : ((b >> (14 - r * 3 - k)) & 1) == 1
          if on
            var bx = x + k * 2                     # slim 1: flag + 2 px stem, no foot
            var bw = 2
            if nar && d != 1
              bx = x + (k == 0 ? 0 : k + 1)
              bw = k == 1 ? 1 : 2
            end
            var c = g5[r]
            var s = sw < -50 ? 99 : bx - self.tx + r * 2 - sw   # -99 = no shine (other pages; tx is nil until the first weather data)
            if s > -3 && s < 3 c = self.mix(c, 0xFFFFFF, 0.75 * (1 - (s < 0 ? -s : s) / 3.0)) end
            rect_fill(bx, r * 2 + yo, bw, 2, c)
          end
        end
      end
      x += d == 1 ? 5 : (nar ? 6 : 7)
      i += 1
    end
    return x
  end

  # Weather view, shifted by oy rows; t = seconds since shown
  def wview(oy, t)
    if self.tg == nil                            # no weather yet: loading, or the code of the failed request
      if self.hst == nil text(23, 10 + oy, "...", 0x666666)
      else
        var e = "ERR " + str(self.hst)
        text(17 + (35 - text_ink_width(e)) / 2, 10 + oy, e, 0xB04040)
      end
    end
    # Symbol fades in
    if self.wk >= 0
      self.icon(self.wk, t)
      var f = clamp(t / 0.4, 0, 1)
      var fb = self.fb
      for i : 0 .. 255
        var c = fb[i]
        if c pixel(i % 16, i / 16 + oy, f < 1 ? self.col(c, f) : c) end
      end
    end
    if self.tg == nil return end

    # Temperature (and humidity): digits drop in one after another, colour gradient, a shine every 4 s.
    # "wechselnd" swaps them every 4 s, each swap drops the digits in again.
    var sw = t < 1.2 ? -99 : ((t - 1.2) % 4.0) * 26 - 6
    var alt = self.hum == "alternate" && self.hg != nil
    var ph = alt ? int(t / 4.0) % 2 : 0
    var tt = alt ? t % 4.0 : t
    if ph == 0
      var x = self.glyphs(self.tg, self.tx, self.tc5, oy, tt, 0, sw)
      if self.unit != "F" || self.tu != nil rect(x, self.ly, 3, 3, self.tc5[0]) end      # the ° ring
      if self.tu != nil self.glyphs(self.tu, x + 4, self.tc5, oy, tt, size(self.tg), sw) end   # C or F
    end
    if self.hg != nil && (!alt || ph == 1)
      self.glyphs(self.hg, self.hx, self.hc5, oy, tt, alt ? 0 : size(self.tg), sw)
    end

    # Forecast area wipes in from the left; the current hour pulses
    var wv = int(clamp((t - 0.35) / 0.8, 0, 1) * 35)
    var pl = 0.6 + 0.4 * math.sin(t * 4)
    i = 0
    for y : self.ay
      if i >= wv break end
      var lit = i == self.nx
      pixel(17 + i, y + oy, lit ? self.mix(self.ac[i], 0xFFFFFF, pl) : self.ac[i])
      if y < 15 rect_fill(17 + i, y + 1 + oy, 1, 15 - y, lit ? self.ab[i] : self.ad[i]) end
      i += 1
    end
    if wv >= 35
      if self.tm >= 0 pixel(self.tm, 10 + oy, self.mcol) end
      if self.tn >= 0 pixel(self.tn, 10 + oy, self.ncol) end
    end
    if self.age > 15 * 60 + 600 pixel(16, 15 + oy, 0xFF0000) end   # data overdue
  end

  # Rain page: umbrella (open with drops while it rains, a single drop when rain is coming, furled
  # when it stays dry), when it starts or stops, and the next 3 hours as 15-minute bars
  def rview(oy, t)
    var fb = self.fb
    for i : 0 .. 255 fb[i] = 0 end
    var st = self.rst
    if st == 0
      self.lay("uz", 0, 0, 1)
      var gy = int((t % 3.5) * 6)                # a gleam runs down the furled cloth
      if gy >= 4 && gy <= 10 && gy != 6 self.pt(7, gy, 0xFFFFFF, 0.55) end
    else
      var ut = self.ut
      if st == 2
        var r = self.rn
        var n = clamp(int(4 + self.rq * 5), 3, 10)
        for i : 0 .. n - 1
          var x = 1 + int(r[i + 3] * 14)
          var top = ut[x]
          var span = top + 2.0
          var yy = int((t * 9 * (0.8 + 0.4 * r[i + 19]) + r[i + 35] * span) % span - 1.5)
          if yy < top
            self.pt(x, yy, 0x5AA0F0, 1.0)
            self.pt(x, yy - 1, 0x5AA0F0, 0.4)
          elif yy == top                         # splashes off the canopy
            self.pt(x - 1, top - 1, 0x8CC8FF, 0.6)
            self.pt(x + 1, top - 1, 0x8CC8FF, 0.6)
          end
        end
        for j : 0 .. 1                           # drips off both ends of the canopy
          var u = (t + j * 0.55) % 1.1
          self.pt(j == 0 ? 1 : 15, int(8 + u * 7), 0x5AA0F0, 1 - u / 1.1)
        end
      else
        var u = t % 3.0                          # rain coming: now and then one drop
        var yy = int(u * 3.2 - 1)
        if u < 1.4 && yy < ut[5] self.pt(5, yy, 0x5AA0F0, u < 0.3 ? u / 0.3 : 1.0) end
      end
      self.lay("uo", 0, 0, 1)
    end
    var f = clamp(t / 0.4, 0, 1)
    for i : 0 .. 255
      var c = fb[i]
      if c pixel(i % 16, i / 16 + oy, f < 1 ? self.col(c, f) : c) end
    end

    # Text slides in from the right, bars grow one after another; hour marks on the base line
    var e = self.ez((t - 0.2) / 0.5)
    text(self.rtx + int((1 - e) * 36), 6 + oy, self.rtt, self.rtc)
    for i : 0 .. 11
      var x = 17 + i * 3
      var hh = int(self.rbh[i] * clamp((t - 0.35 - i * 0.05) / 0.3, 0, 1) + 0.5)
      if hh <= 0
        rect_fill(x, 15 + oy, 2, 1, 0x1C2028)
      else
        for yy : 0 .. hh - 1
          rect_fill(x, 15 - yy + oy, 2, 1, yy == hh - 1 ? self.mix(self.rbc[i], 0xFFFFFF, 0.3) : self.rbc[i])
        end
      end
      if i > 0 && self.rtk[i] pixel(x - 1, 15 + oy, 0x505060) end
    end
  end

  # Sun page symbol: the sun on the horizon, rays breathing, glitter on the water below
  def sicon(t)
    var fb = self.fb
    for i : 0 .. 255 fb[i] = 0 end
    var pa = 0.5 + 0.5 * math.sin(t * 2.4)
    for j : 0 .. 6
      var an = 3.1416 + j * 0.5236                       # 180..360 degrees: upper half only
      var a = j % 2 ? pa : 1 - pa
      for d : [6.4, 7.4]
        var x = int(8.0 + math.cos(an) * d)
        var y = int(12.0 + math.sin(an) * d)
        if y < 12 self.pt(x, y, d < 7 ? 0xFFC830 : 0xFF9A10, d < 7 ? 0.5 + 0.5 * a : a) end
      end
    end
    self.lay("hs", 0, 0, 1)
    for x : 0 .. 15                                      # horizon, brightest under the sun
      var dx = (x + 0.5 - 8.0) / 8.0
      self.pt(x, 12, 0xFF9A40, 1 - dx * dx * 0.8)
    end
    for i : 0 .. 4                                       # glitter on the water
      var w = 0.5 + 0.5 * math.sin(t * (2.0 + i * 0.6) + i * 1.9)
      var x = 4 + (i * 5) % 9
      self.pt(x, 13 + i % 3, 0xFFB050, 0.6 * w * w)
      self.pt(x + 1, 13 + i % 3, 0xFFB050, 0.4 * w * w)
    end
  end

  # Wind page symbol: a compass rose. The needle points where the wind blows to, its dim tail where it
  # comes from. It swings in from north, then trembles with the gusts; air streams across the dial.
  def wrose(t)
    var fb = self.fb
    for i : 0 .. 255 fb[i] = 0 end
    self.lay("wr", 0, 0, 1)
    var v = self.wsv
    if self.wdv == nil || v < 2                  # calm or unknown: only the hub breathes
      var a = 0.45 + 0.35 * math.sin(t * 2.0)
      for y : 7 .. 8
        for x : 7 .. 8 self.pt(x, y, 0xC8D0DC, a) end
      end
      return
    end
    var n = (self.wdv + 180) % 360
    if n > 180 n -= 360 end
    var g = self.wgv == nil ? 0 : clamp((self.wgv - v) / (v < 10 ? 10.0 : v), 0, 1)
    var a = (n - n * math.exp(-2.2 * t) * math.cos(4.5 * t) +
             (2 + 10 * g) * (math.sin(t * 3.1) + 0.4 * math.sin(t * 7.7))) * 0.0174533
    var ux = math.sin(a)
    var uy = -math.cos(a)
    var r = self.rn
    for i : 0 .. clamp(int(v / 7) + 1, 1, 6) - 1
      var p = (t * (2.5 + v / 8.0) * (0.8 + 0.4 * r[i + 40]) + r[i + 20] * 12) % 12.0 - 6
      var q = (r[i + 50] - 0.5) * 9
      if p * p + q * q < 30 self.sp(7.5 + p * ux - q * uy, 7.5 + p * uy + q * ux, 0x8CB4D8, 0.45 * (1 - (p < 0 ? -p : p) / 6.0)) end
    end
    var s = -4.5
    while s <= 5.0
      self.sp(7.5 + s * ux, 7.5 + s * uy, s > 0 ? self.wnc : 0x7A8696, s > 0 ? 1.0 : 0.8)
      s += 0.5
    end
    var tx = 7.5 + 5.2 * ux
    var ty = 7.5 + 5.2 * uy
    for k : 1 .. 5                               # arrow head: two barbs back from the tip
      var b = k * 0.55
      self.sp(tx + b * (-ux * 0.819 + uy * 0.574), ty + b * (-ux * 0.574 - uy * 0.819), self.wnc, 1.0)
      self.sp(tx + b * (-ux * 0.819 - uy * 0.574), ty + b * (ux * 0.574 - uy * 0.819), self.wnc, 1.0)
    end
  end

  # Wind page: rose, speed <-> gusts every 4 s (soft cross-fade), the next 12 hours as bars
  def windv(oy, t)
    self.wrose(t)
    self.out(0, oy, clamp(t / 0.4, 0, 1))
    var V = self.wv
    var n = size(V)
    if n == 0
      text(30, 6 + oy, "...", 0x666666)
    else
      var ph = n > 1 ? int(t / 4.0) % 2 : 0
      var u = t - int(t / 4.0) * 4.0
      var f = 1.0
      if n > 1
        f = clamp((4.0 - u) / 0.35, 0, 1)
        if t >= 4 f = f * clamp(u / 0.35, 0, 1) end
      end
      var D = V[ph]
      var c = self.wc5f
      for i : 0 .. 4 c[i] = self.col(D["c5"][i], f) end
      var nr = self.nar
      self.nar = D["nar"]
      self.glyphs(D["g"], D["x"], c, oy, t < 4 ? t : 9.0, 0, -99)
      self.nar = nr
      var xo = int((1 - self.ez((t - 0.3) / 0.5)) * 36)
      text(D["rx"] + xo, 5 + oy, D["lab"], self.col(D["lc"], f))
      text(D["rx"] + xo, 11 + oy, D["u"], self.col(0x8A92A2, f))   # a free row below the direction
    end
    if size(self.wb) < 12 return end
    for i : 0 .. 11
      var B = self.wb[i]
      var x = 17 + i * 3
      var e = clamp((t - 0.35 - i * 0.05) / 0.3, 0, 1)
      var h = B[0] * e
      var k = int(h)
      if h < 0.2 rect_fill(x, 15 + oy, 2, 1, 0x1C2028) end
      for yy : 0 .. k - 1 rect_fill(x, 15 - yy + oy, 2, 1, B[1]) end
      if h - k > 0.2 rect_fill(x, 15 - k + oy, 2, 1, self.col(B[1], h - k)) end
      for yy : int(math.ceil(h)) .. int(B[2] * e + 0.5) - 1 rect_fill(x, 15 - yy + oy, 2, 1, B[3]) end   # gusts
      if i > 0 && B[4] pixel(x - 1, 15 + oy, B[4]) end
    end
  end

  def sview(oy, t)
    self.sicon(t)
    self.out(0, oy, clamp(t / 0.4, 0, 1))
    self.rows(oy, t, self.srs, self.sss, self.snev, 0xFFD040, 0xFF7A30, self.stw)
  end

  # Two rows: arrow up + rise time, arrow down + set time; they slide in from the right.
  # The next event is lit, the other dimmed; the arrows nudge in their direction.
  def rows(oy, t, a, b, ev, c1, c2, tw, f)
    if f == nil f = 1.0 end                      # optional fade 0..1
    var gx = 17 + (35 - 7 - tw) / 2
    for r : 0 .. 1
      var e = self.ez((t - 0.25 - r * 0.15) / 0.5)
      var xo = int((1 - e) * 36)
      var dim = ev != 0 && ev != r + 1
      var ac = r == 0 ? c1 : c2
      ac = self.col(ac, dim ? 0.4 * f : f)
      var by = r == 0 ? 1 : 10
      var bob = (t + r * 1.0) % 2.0 < 0.45 ? (r == 0 ? -1 : 1) : 0
      var ax = gx + xo
      var ar = r == 0 ? [4, 14, 31, 4, 4] : [4, 4, 31, 14, 4]
      for yy : 0 .. 4
        for xx : 0 .. 4
          if (ar[yy] >> (4 - xx)) & 1 pixel(ax + xx, by + yy + bob + oy, ac) end
        end
      end
      text(ax + 7, by + 5 + oy, r == 0 ? a : b, self.col(dim ? 0x707078 : 0xF2F2F6, f))
    end
  end

  # One forecast day at ox: symbol, weekday + rain chance on top, max as block digits, min beside it
  def fday(d, ox, oy, t)
    var D = self.fdd[d]
    var w = self.wh
    var q = self.qi
    var s = self.sl
    self.wh = 0                                  # the day's symbol, not today's rain amount or wind
    self.qi = 1.0
    self.sl = 0.0
    self.icon(D["k"], t)
    self.wh = w
    self.qi = q
    self.sl = s
    self.out(ox, oy, 1)
    text(17 + ox, 5 + oy, D["lab"], D["lc"])
    if D["pr"] != "" text(D["px"] + ox, 5 + oy, D["pr"], 0x5AA0F0) end
    var nr = self.nar
    self.nar = false
    var x = self.glyphs(D["g"], D["x"] + ox, D["c5"], oy + 6, 9.0, 0, -99)
    self.nar = nr
    if self.unit != "F" rect(x, oy + 6, 3, 3, D["c5"][0]) end
    text(D["rx"] + ox, 16 + oy, D["mn"], D["mc"])
  end

  # Three days, 3.5 s each; the next day pushes the last one out to the left
  def fview(oy, t)
    var n = size(self.fdd)
    if n == 0
      text(30, 10 + oy, "...", 0x666666)
      return
    end
    var d = int(t / 3.5) % n
    var u = t - int(t / 3.5) * 3.5
    if t >= 3.5 && u < 0.4
      var xo = int((1 - self.ez(u / 0.4)) * 52 + 0.5)
      self.fday((d + n - 1) % n, xo - 52, oy, t)
      self.fday(d, xo, oy, t)
    else
      self.fday(d, 0, oy, t)
    end
  end

  # Moon view, shifted by oy rows; t = seconds since the switch
  def mview(oy, t)
    var m = self.mimg
    if m != nil
      var sw = t < 0.8 ? -99 : ((t - 0.8) % 4.5) * 12 - 6   # soft gleam across the lit part
      var i = 0
      for y : 0 .. 15
        for x : 0 .. 15
          var c = m[i]
          if c
            var s = x + y - sw
            if s > -2.5 && s < 2.5 && ((c >> 8) & 255) > 110
              c = self.mix(c, 0xFFFFFF, 0.4 * (1 - (s < 0 ? -s : s) / 2.5))
            end
            pixel(x, y + oy, c)
          end
          i += 1
        end
      end
    end

    # Every 4 s a soft cross-fade: moonrise/moonset <-> lit share in % with the lunar cycle line
    var ph = int(t / 4.0) % 2
    var u = t - int(t / 4.0) * 4.0
    var f = clamp((4.0 - u) / 0.35, 0, 1)
    if t >= 4 f = f * clamp(u / 0.35, 0, 1) end
    if ph == 0 || self.mpg == nil
      self.rows(oy, t, self.rs, self.ss, self.nev, 0xFFC860, 0x7DA8F0, self.mtw, ph == 0 ? f : 1.0)
      return
    end
    var c = self.mc5f
    for i : 0 .. 4 c[i] = self.col(self.mc5[i], f) end
    var nr = self.nar
    self.nar = false
    self.glyphs(self.mpg, 17 + (35 - self.mpw) / 2, c, oy, 9.0, 0, -99)
    self.nar = nr
    # Lunar cycle: new moon (left) - full moon (middle) - new moon (right), today's dot pulses
    var lc = self.col(0x303038, f)
    for x : 17 .. 51 pixel(x, 13 + oy, lc) end
    var ec = self.col(0x505060, f)
    pixel(17, 12 + oy, ec) pixel(17, 14 + oy, ec) pixel(51, 12 + oy, ec) pixel(51, 14 + oy, ec)
    rect_fill(33, 12 + oy, 3, 3, self.col(0x908870, f))
    var mx = 17 + int(self.mf * 34 + 0.5)
    var dc = self.col(0x8A8270, f)
    for x : 17 .. mx pixel(x, 13 + oy, dc) end
    rect_fill(mx - 1, 12 + oy, 3, 3, self.col(0xFFF4D0, f * (0.6 + 0.4 * math.sin(t * 4))))
  end

  def page(k, oy, t)
    if oy <= -16 || oy >= 16 return end
    if k == 0 self.wview(oy, t)
    elif k == 1 self.rview(oy, t)
    elif k == 3 self.sview(oy, t)
    elif k == 4 self.fview(oy, t)
    elif k == 5 self.windv(oy, t)
    else self.mview(oy, t) end
  end

  def draw()
    clear()
    font("small")
    var now = now_ms()
    # A page change slides up (forward) or down (back); the old page leaves on the other side
    var e = self.ez((now - self.ts) / 500.0)
    var cur = self.pages[self.pi]
    if self.pp >= 0 && e < 1
      var dn = self.pi > self.pp ? 1 : -1
      var off = int((1 - e) * 16 + 0.5) * dn
      self.page(self.pages[self.pp], off - 16 * dn, (now - self.tp) / 1000.0)
      self.page(cur, off, (now - self.ps) / 1000.0)
    else
      self.page(cur, 0, (now - self.ps) / 1000.0)
    end
    # Page dots in the gap column, one per page, the current one lit
    var np = size(self.pages)
    if np > 1
      for i : 0 .. np - 1 pixel(16, 8 - np + i * 2, i == self.pi ? 0xB4B4C0 : 0x2A2A34) end
    end
  end

  def on_button(btn)
    if btn == "select" self.ticks = 0 end   # refresh, the press still passes on
  end
end

return BeautifulWeather()
